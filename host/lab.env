# shellcheck shell=bash
# Shared settings for the host-side scripts. Source it; do not execute it.
# Every value can be overridden from the environment before running a script.

LAB_REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Large runtime data (ISOs, disks, firmware vars, TPM state, secrets) lives OUTSIDE the repo.
LAB_RUNTIME="${LAB_RUNTIME:-$(cd "$LAB_REPO_ROOT/.." && pwd)/lab-runtime}"
# Unix sockets (QMP, guest agent, lab LAN) go to a short private path (108-char socket limit).
LAB_RUN_DIR="${LAB_RUN_DIR:-${XDG_RUNTIME_DIR:-/tmp}/smallbiz-lab}"

# ---- Installation media (Microsoft Evaluation Center + Fedora virtio-win) -------------
ISO_DIR="${ISO_DIR:-$LAB_RUNTIME/iso}"
SERVER_ISO="${SERVER_ISO:-$ISO_DIR/WS2025_SERVER_EVAL_x64FRE_en-us.iso}"
CLIENT_ISO="${CLIENT_ISO:-$ISO_DIR/Win11_Ent_LTSC2024_EVAL_x64FRE_en-us.iso}"
VIRTIO_ISO="${VIRTIO_ISO:-$ISO_DIR/virtio-win.iso}"
# Official links copied from the Evaluation Center download pages (en-US, x64).
SERVER_ISO_URL='https://go.microsoft.com/fwlink/?linkid=2345730&clcid=0x409&culture=en-us&country=us'
CLIENT_ISO_URL='https://go.microsoft.com/fwlink/?linkid=2289029&clcid=0x409&culture=en-us&country=us'
VIRTIO_ISO_URL='https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/stable-virtio/virtio-win.iso'
# install.wim indexes (checked with host/wiminfo.py):
#   Server ISO 1 = Windows Server 2025 Standard Evaluation (Server Core)
#   Client ISO 1 = Windows 11 Enterprise LTSC 2024 Evaluation
SERVER_IMAGE_INDEX="${SERVER_IMAGE_INDEX:-1}"
CLIENT_IMAGE_INDEX="${CLIENT_IMAGE_INDEX:-1}"

# ---- VM sizing (kept small on purpose: the reference host has 10 GiB RAM in total) -----
DC01_RAM_MB="${DC01_RAM_MB:-1536}"
CL01_RAM_MB="${CL01_RAM_MB:-2048}"
DC01_CPUS="${DC01_CPUS:-2}"
CL01_CPUS="${CL01_CPUS:-2}"
DC01_OS_DISK_GB=60
DC01_DATA_DISK_GB=20
DC01_BACKUP_DISK_GB=20
CL01_OS_DISK_GB=64          # Windows 11 setup refuses disks smaller than 64 GB

# ---- Isolated lab LAN (layer 2 between the two QEMU processes only) --------------------
DC01_MAC='52:54:00:50:00:10'
CL01_MAC='52:54:00:50:00:21'

# ---- Console: "vnc" binds to 127.0.0.1 only; "gtk" opens a window (needs qemu-system-gui) --
LAB_DISPLAY="${LAB_DISPLAY:-vnc}"
DC01_VNC_DISPLAY=1          # 127.0.0.1:5901
CL01_VNC_DISPLAY=2          # 127.0.0.1:5902

# ---- QEMU / firmware discovery: prefer a user-space copy, fall back to system packages ---
LAB_QEMU_ROOT="${LAB_QEMU_ROOT:-$LAB_RUNTIME/qemu-root}"
if [[ -x "$LAB_QEMU_ROOT/usr/bin/qemu-system-x86_64" ]]; then
  QEMU_BIN="$LAB_QEMU_ROOT/usr/bin/qemu-system-x86_64"
  QEMU_IMG="$LAB_QEMU_ROOT/usr/bin/qemu-img"
  SWTPM_BIN="$LAB_QEMU_ROOT/usr/bin/swtpm"
  XORRISO_BIN="$LAB_QEMU_ROOT/usr/bin/xorriso"
  OVMF_DIR="$LAB_QEMU_ROOT/usr/share/OVMF"
  QEMU_DATA_ARGS=(-L "$LAB_QEMU_ROOT/usr/share/qemu" -L "$LAB_QEMU_ROOT/usr/share/seabios")
  LAB_LD_LIBRARY_PATH="$LAB_QEMU_ROOT/usr/lib/x86_64-linux-gnu:$LAB_QEMU_ROOT/usr/lib/x86_64-linux-gnu/swtpm"
  LAB_QEMU_MODULE_DIR="$LAB_QEMU_ROOT/usr/lib/x86_64-linux-gnu/qemu"
else
  QEMU_BIN="$(command -v qemu-system-x86_64 || true)"
  QEMU_IMG="$(command -v qemu-img || true)"
  SWTPM_BIN="$(command -v swtpm || true)"
  XORRISO_BIN="$(command -v xorriso || true)"
  OVMF_DIR="/usr/share/OVMF"
  QEMU_DATA_ARGS=()
  LAB_LD_LIBRARY_PATH=""
  LAB_QEMU_MODULE_DIR=""
fi
OVMF_CODE="$OVMF_DIR/OVMF_CODE_4M.secboot.fd"   # Secure Boot capable firmware
OVMF_VARS_TEMPLATE="$OVMF_DIR/OVMF_VARS_4M.ms.fd" # Microsoft keys pre-enrolled

LAB_PYTHON="${LAB_PYTHON:-python3}"
LAB_SECRETS_FILE="${LAB_SECRETS_FILE:-$LAB_RUNTIME/secrets/lab-secrets.env}"

lab_env_exports() {
  # Export library paths so the user-space binaries find their shared objects.
  if [[ -n "$LAB_LD_LIBRARY_PATH" ]]; then
    export LD_LIBRARY_PATH="$LAB_LD_LIBRARY_PATH${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export QEMU_MODULE_DIR="$LAB_QEMU_MODULE_DIR"
  fi
}
